# Copy to .env and replace all CHANGE_ME values before starting.
NODE_ENV=production  # Set to 'development' as needed
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_NAME=Admin
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=CHANGE_ME_TEST_PASSWORD
TEST_USER_NAME=Test User
RABBITMQ_DEFAULT_USER=saas
RABBITMQ_DEFAULT_PASS=CHANGE_ME_RABBITMQ_PASSWORD
RABBITMQ_HOST=messaging-service
RABBITMQ_PORT=5672
RABBITMQ_API_PORT=15672
USERS_EXCHANGE=USERS_EXCHANGE
TRANSACTIONS_EXCHANGE=TRANSACTIONS_EXCHANGE
SUBMISSIONS_EXCHANGE=SUBMISSIONS_EXCHANGE
RESULTS_EXCHANGE=RESULTS_EXCHANGE
USER_TRANSACTIONS_QUEUE=USER_TRANSACTIONS_QUEUE
SUBMISSION_RESULTS_QUEUE=SUBMISSION_RESULTS_QUEUE
SOLVER_SUBMISSIONS_QUEUE=SOLVER_SUBMISSIONS_QUEUE
RESULT_RESULTS_QUEUE=RESULT_RESULTS_QUEUE
ANALYTICS_USERS_QUEUE=ANALYTICS_USERS_QUEUE
ANALYTICS_TRANSACTIONS_QUEUE=ANALYTICS_TRANSACTIONS_QUEUE
ANALYTICS_SUBMISSIONS_QUEUE=ANALYTICS_SUBMISSIONS_QUEUE
ANALYTICS_RESULTS_QUEUE=ANALYTICS_RESULTS_QUEUE
MONGODB_URI_USER_SERVICE=mongodb://user-service-db:27017/user_service
MONGODB_URI_TRANSACTION_SERVICE=mongodb://transaction-service-db:27017/transaction_service
MONGODB_URI_SUBMISSION_SERVICE=mongodb://submission-service-db:27017/submission_service
MONGODB_URI_SOLVER_MODEL_SERVICE=mongodb://solver-model-service-db:27017/solver_model_service
MONGODB_URI_RESULT_SERVICE=mongodb://result-service-db:27017/result_service
STORAGE_ENDPOINT=storage-service
STORAGE_PORT=9000
STORAGE_ACCESS_KEY=saas-storage
STORAGE_SECRET_KEY=CHANGE_ME_STORAGE_PASSWORD
MINIO_ROOT_USER=saas-admin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
REDIS_HOST=redis
REDIS_PORT=6379
RABBITMQ_APP_USER_NAME=saas-app
RABBITMQ_APP_USER_PASSWORD=CHANGE_ME_APP_PASSWORD
RABBITMQ_ORTOOLS_USER_NAME=saas-solver
RABBITMQ_ORTOOLS_USER_PASSWORD=CHANGE_ME_SOLVER_PASSWORD
